# Local PostgreSQL container settings (copy to .env and replace placeholders)
POSTGRES_USER=maxi_loop
POSTGRES_PASSWORD=replace_with_local_dev_password
POSTGRES_DB=maxi_loop
POSTGRES_PORT=55432

# Application server configuration
APP_HOST=127.0.0.1
APP_PORT=8080
PUBLIC_BASE_URL=http://127.0.0.1:8080
DATABASE_URL=postgres://maxi_loop:replace_with_local_dev_password@127.0.0.1:55432/maxi_loop
DB_MAX_CONNECTIONS=10

# Auth & tenant mode defaults
SINGLE_TENANT_MODE=true
COOKIE_SECURE=false
SESSION_TTL_HOURS=168

# Retention & storage defaults
RETENTION_DEFAULT_DAYS=30
MAX_FULL_EVENTS_PER_ISSUE=50

# Ingest limits & backpressure defaults
MAX_ENVELOPE_COMPRESSED_BYTES=1048576
MAX_ENVELOPE_DECOMPRESSED_BYTES=2097152
MAX_EVENT_PAYLOAD_BYTES=524288
INGEST_CHANNEL_CAPACITY=1024

# Single-tenant / first-boot bootstrap defaults
DEFAULT_TENANT_SLUG=default
DEFAULT_TENANT_NAME=Default Organization
DEFAULT_WORKSPACE_SLUG=default
DEFAULT_WORKSPACE_NAME=Default Workspace
# Optional: set both to create/update initial tenant_owner admin on startup or via `maxi-loop bootstrap`
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=replace_with_12_plus_char_password
# BOOTSTRAP_ADMIN_NAME=Administrator

# Logging (pretty | json) and RUST_LOG filter
LOG_FORMAT=pretty
RUST_LOG=maxi_loop=info,tower_http=info

# Optional SMTP settings for Email alert channels (leave unset to disable email delivery)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=alerts@example.com
# SMTP_USERNAME=replace_with_smtp_username
# SMTP_PASSWORD=replace_with_smtp_password
# SMTP_USE_TLS=true
